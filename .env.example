# Copy to .env.local and fill in.
# A long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000
# SQLite file location (defaults to ./data/moasis.db)
DATABASE_PATH=./data/moasis.db
# Anthropic API key for the Brand studio's AI partner and logo drawing (server only).
# On Vercel: Settings → Environment Variables, ticked for Production and Preview.
ANTHROPIC_API_KEY=
