# Copy to .env.local and fill in.
# A long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public URL of the app
BETTER_AUTH_URL=http://localhost:3000
# SQLite file location (defaults to ./data/moasis.db)
DATABASE_PATH=./data/moasis.db
# Anthropic API key for the Brand studio's AI partner and logo drawing (server only).
# On Vercel: Settings → Environment Variables, ticked for Production and Preview.
ANTHROPIC_API_KEY=
# Hosted Postgres for permanent accounts (Supabase, Neon…). When set, SQLite is not used.
# Supabase: Project settings → Database → Connection string (use the pooler URL on Vercel).
DATABASE_URL=
# Password-reset email through Resend (resend.com). Both must be set; EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM="Moasis <hello@your-domain.om>"

# Where the "Partner with Moasis" form sends companies and leaders (opens their email app).
# Without it the form copies the details and asks them to contact the team directly.
NEXT_PUBLIC_PARTNERS_EMAIL=
